SECRET_KEY=change-me
FLASK_APP=iopstor
# Local development: debugger + auto-reload on every code/template change. Never set in production.
FLASK_DEBUG=1
SITE_URL=http://localhost:5000
# Self-hosted Supabase API gateway (Kong). Everything — data, auth, storage — goes through it with the supabase library.
# The dev box has a self-signed cert on https, so use http:// on the LAN; use https:// once a real certificate is installed.
SUPABASE_URL=http://developmentserver-supabase-9f7088-111-125-233-170.sslip.io
# Same values as ANON_KEY / SERVICE_ROLE_KEY / JWT_SECRET in the Supabase compose environment in Dokploy
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Public bucket for uploads (create it in Supabase Studio → Storage)
MEDIA_BUCKET=media
PAYMENT_PROVIDER=dummy
# Failed-password throttle. The file lives on tmpfs so all gunicorn workers share it and a redeploy
# clears it; point it elsewhere in development so a local run does not write to /dev/shm.
THROTTLE_DB=/dev/shm/iopstor-throttle.db
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW=900
# Container only: gunicorn reads this itself. The Dockerfile default is -w 2 --threads 8 --preload
# --access-logfile -; production sets the worker count in Dokploy. A worker costs ~63 MB alone, ~15 MB more
# when preloaded; a thread almost nothing (docs/TECHNICAL.md §15).
# GUNICORN_CMD_ARGS="-w 30 --threads 8 --preload --access-logfile -"

# ---------------------------------------------------------------------------------------------------
# Production (Dokploy + Cloudflare Tunnel). These go in the Compose service's environment in Dokploy,
# never in a file in the repo -- .env and .env.* are both ignored. Runbook: docs/TECHNICAL.md §15.
#
#   SECRET_KEY=<fresh random>            # required; no default, the app refuses to boot without it
#   SITE_URL=https://www.iopstor.com     # required; every canonical, and the cookie's Secure flag
#   SUPABASE_URL=http://<kong-service>:8000   # Kong by service name on dokploy-network, never public
#   SUPABASE_ANON_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...        # bypasses RLS: Dokploy's environment and nowhere else
#   SUPABASE_JWT_SECRET=...
#   MEDIA_BUCKET=media
#   PAYMENT_PROVIDER=dummy
#   GUNICORN_CMD_ARGS=-w 30 --threads 8 --preload --access-logfile -
#   TUNNEL_TOKEN=...                     # read by the cloudflared service in docker-compose.yml
#   COMPOSE_PROFILES=tunnel              # read by Compose itself: without it cloudflared never starts
#
# FLASK_DEBUG must be ABSENT in production. Nothing in the Dockerfile guards it.
